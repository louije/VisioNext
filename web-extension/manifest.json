{
  "manifest_version": 3,
  "name": "VisioNext — adaptive Visio layout",
  "version": "0.1.1",
  "description": "Adapts the participant strip to the shared screen on Visio (visio.numerique.gouv.fr) — more faces, placed where the grey bars are.",
  "homepage_url": "https://github.com/louije/visio-next",
  "browser_specific_settings": {
    "gecko": {
      "id": "visio-meet-layout@meidosem.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Adaptive Visio layout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://visio.numerique.gouv.fr/*"],
      "css": ["enhance.css"],
      "js": ["layout-engine.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
