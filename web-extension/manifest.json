{
  "manifest_version": 3,
  "name": "VisioNext — Meet multi-column strip",
  "version": "0.1.0",
  "description": "Adapts the participant strip to the shared content when a screen is shared on Meet / visio.numerique.gouv.fr (LiveKit).",
  "browser_specific_settings": {
    "gecko": {
      "id": "visio-meet-layout@meidosem.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Adaptive Meet layout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://visio.numerique.gouv.fr/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "css": ["enhance.css"],
      "js": ["layout-engine.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
